{
  "manifest_version": 3,
  "name": "CursorClip",
  "version": "1.20",
  "description": "Point at any element on a page and copy its HTML and the CSS that styles it, as a file or as text.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "CursorClip\nClick: pick an element and copy its HTML + CSS\nRight click → Options",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": ["storage", "downloads", "downloads.ui", "nativeMessaging", "activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shortcuts.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["cursors/*.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
